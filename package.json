{
  "name": "volt-battery",
  "version": "1.1.0",
  "description": "Компактный монитор батареи Mac, iPhone и iPad",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "pack": "electron-builder --mac dir",
    "dist": "electron-builder --mac dmg"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.local.voltbattery",
    "productName": "Volt Battery",
    "files": [
      "electron/**/*",
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "Volt Battery находит сопряжённые iPhone и iPad в вашей локальной сети и читает сведения о батарее.",
        "NSBonjourServices": [
          "_apple-mobdev2._tcp"
        ]
      }
    },
    "dmg": {
      "title": "Volt Battery"
    }
  },
  "dependencies": {
    "plist": "^3.1.0"
  }
}
